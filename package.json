{
  "name": "merciful-front-are-3a6cn",
  "productName": "valueXpro",
  "description": "Risk Management Application",
  "version": "1.0.0",
  "author": "ronal",
  "main": "./src/main/index.js",
  "scripts": {
    "ipc:audit": "node src/scripts/ipc-audit.js",
    "start:electron": "electron .",
    "start": "set NODE_ENV=development && npm run ipc:audit && npm run start:electron",
    "sync:worker": "node src/scripts/sync-worker.js",
    "prebuild": "npm run sync:worker",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.example.valueXpro",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!dist.zip",
      "!venv/**",
      "!docs/**",
      "!*.code-workspace",
      "!renderer_py-flow.txt",
      "!logfile.txt",
      "!files/**"
    ],
    "extraResources": [
      {
        "from": "files",
        "to": "files"
      },
      {
        "from": "bin/main",
        "to": "bin/main"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "valueXpro.${ext}",
      "icon": "src/main/vXp.ico"
    }
  },
  "dependencies": {
    "axios": "^1.13.2",
    "better-sqlite3": "^11.9.1",
    "chart.js": "^4.4.4",
    "chartjs-adapter-date-fns": "^3.0.0",
    "cubic-spline": "^3.0.3",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.18",
    "dotenv": "^16.3.1",
    "lightweight-charts": "^4.2.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^5.1.91",
    "plotly.js-dist-min": "^3.3.0",
    "scipy": "^0.1.4",
    "sqlite3": "^5.1.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.4.0"
  }
}

